# @file Makefile
# @brief `make` instructions for building and testing CLASS(-PT).
# @author Julien Lesgourgues
# @maintainer Mike S Wang (https://github.com/MikeSWang)
#

# ========================================================================
# Configuration
# ========================================================================

# ------------------------------------------------------------------------
# Preamble
# ------------------------------------------------------------------------

# Library/package information
LIBNAME := class
PKGNAME := classy

# Directories
DIR_ROOT := $(shell pwd)

DIR_INCLUDE := ${DIR_ROOT}/include
DIR_SOURCE := ${DIR_ROOT}/source
DIR_TOOLS := ${DIR_ROOT}/tools
DIR_MAIN := ${DIR_ROOT}/main
DIR_PYTHON := ${DIR_ROOT}/python
DIR_BUILD := ${DIR_ROOT}/build
DIR_TEST := ${DIR_ROOT}/test

DIR_BUILDOBJ := ${DIR_BUILD}/obj
DIR_BUILDLIB := ${DIR_BUILD}/lib

# System information
OS := $(shell uname -s)

# Escape characters
COMMA := ,


# ------------------------------------------------------------------------
# Compilation
# ------------------------------------------------------------------------

# -- Compiler ------------------------------------------------------------

CC ?= gcc
AR ?= ar
PYTHON ?= python3


# -- Options -------------------------------------------------------------

CPPFLAGS += -D__CLASSDIR__=\"${DIR_ROOT}\"
INCLUDES += -I${DIR_INCLUDE}
CFLAGS += -fPIC -pthread -Wall -g -ggdb3 -O3 -ffast-math
ARFLAGS := -rcsv


# -- Dependencies --------------------------------------------------------

# Core mathematical libraries.
DEPS := openblas m
# DEPS := gsl fftw3

INCLUDES_DEPS := $(shell pkg-config --silence-errors --cflags-only-I ${DEPS})
CFLAGS_DEPS := $(shell pkg-config --silence-errors --cflags-only-other ${DEPS})
LDFLAGS_DEPS := $(shell pkg-config --silence-errors --libs-only-other --libs-only-L ${DEPS})
LDLIBS_DEPS := $(shell pkg-config --silence-errors --libs-only-l ${DEPS})

INCLUDES += ${INCLUDES_DEPS}
LDFLAGS += \
	$(addprefix -Wl${COMMA}-rpath${COMMA}, $(patsubst -L%, %, ${LDFLAGS_DEPS})) \
	${LDFLAGS_DEPS}
LDLIBS += $(foreach dep, ${DEPS}, $(if $(filter $(dep), ${LDLIBS_DEPS}),, -l$(dep)))

# Use OpenMP if available.
OMPFLAG := -fopenmp
USEOMP := $(shell $(CC) $(OMPFLAG) -dM -E - < /dev/null 2>/dev/null | grep -q OPENMP && echo true)
ifeq (${USEOMP}, true)
CFLAGS_OMP := $(OMPFLAG)
LDFLAGS_OMP := $(OMPFLAG)
endif

CFLAGS += ${CFLAGS_OMP}
LDFLAGS += ${LDFLAGS_OMP}


# -- Customisation -------------------------------------------------------

# Add HyRec if available by setting the path.
HYREC := ${DIR_ROOT}/hyrec

ifneq (${HYREC},)
CPPFLAGS += -DHYREC
INCLUDES += -I${HYREC}
endif

# Inherit Conda environment if embedded.
ifdef CONDA_PREFIX
INCLUDES += -I${CONDA_PREFIX}/include
LDFLAGS += -L${CONDA_PREFIX}/lib
endif


# ========================================================================
# Recipes
# ========================================================================

# ------------------------------------------------------------------------
# Targets
# ------------------------------------------------------------------------

# -- Objects -------------------------------------------------------------

CLASS = ${LIBNAME}.o
EXTERNAL =

BACKGROUND = background.o
INPUT = input.o
LENSING = lensing.o
NONLINEAR = nonlinear.o
NONLINEAR_PT = nonlinear_pt.o
OUTPUT = output.o
PERTURBATIONS = perturbations.o
PRECISION = precision.o
PRIMORDIAL = primordial.o
SPECTRA = spectra.o
THERMO = thermodynamics.o
TRANSFER = transfer.o

SOURCE = background.o input.o lensing.o nonlinear.o nonlinear_pt.o \
         perturbations.o primordial.o spectra.o thermodynamics.o transfer.o
TOOLS = arrays.o common.o dei_rkck.o evolver_ndf15.o evolver_rkck.o \
        growTable.o hyperspherical.o parser.o quadrature.o sparse.o
ifneq (${HYREC},)
EXTERNAL += helium.o history.o hydrogen.o hyrectools.o
endif

TEST_BACKGROUND = test_background.o
TEST_DEGENERACY = test_degeneracy.o
TEST_HYPERSPHERICAL = test_hyperspherical.o
TEST_LOOPS = test_loops.o
TEST_LOOPS_OMP = test_loops_omp.o
TEST_NONLINEAR = test_nonlinear.o
TEST_PERTURBATIONS = test_perturbations.o
TEST_SIGMA = test_sigma.o
TEST_STEPHANE = test_stephane.o
TEST_THERMODYNAMICS = test_thermodynamics.o
TEST_TRANSFER = test_transfer.o


# -- Source files --------------------------------------------------------

C_SOURCE = $(addprefix ${DIR_SOURCE}/, $(addsuffix .c, $(basename $(SOURCE) $(OUTPUT))))
C_TOOLS =  $(addprefix ${DIR_TOOLS}/, $(addsuffix .c, $(basename $(TOOLS))))
C_MAIN = $(addprefix ${DIR_MAIN}/, $(addsuffix .c, $(basename $(CLASS))))
C_TEST = $(addprefix ${DIR_TEST}/, $(addsuffix .c, $(basename $(TEST_DEGENERACY) $(TEST_LOOPS) $(TEST_NONLINEAR) $(TEST_PERTURBATIONS) $(TEST_THERMODYNAMICS) $(TEST_TRANSFER))))
C_ALL = $(C_TOOLS) $(C_SOURCE) $(C_MAIN)
H_ALL = $(addprefix ${DIR_INCLUDE}/, common.h svnversion.h $(addsuffix .h, $(basename $(notdir $(C_ALL)))))

PYTHON_FILES = $(addprefix ${DIR_PYTHON}/, setup.py c${PKGNAME}.pxd ${PKGNAME}.pyx test_class.py)

PRE_FILES = cl_ref.pre clt_permille.pre
INI_FILES = explanatory.ini lcdm.ini


# ------------------------------------------------------------------------
# Building
# ------------------------------------------------------------------------

vpath .base ${DIR_BUILD}
vpath %.c ${DIR_SOURCE}:${DIR_TOOLS}:${DIR_MAIN}:${DIR_TEST}
ifneq (${HYREC},)
vpath %.c ${HYREC}
endif
vpath %.o ${DIR_BUILD}/obj

.base:
	@mkdir -p ${DIR_BUILDOBJ} ${DIR_BUILDLIB}
	@touch ${DIR_BUILD}/.base

%.o: %.c .base
	$(CC) $(CPPFLAGS) $(INCLUDES) $(CFLAGS) -c $< -o $(addprefix ${DIR_BUILDOBJ}/, $(notdir $*.o))

all: lib${LIBNAME}.a ${LIBNAME} ${PKGNAME}

lib${LIBNAME}.a: $(SOURCE) $(TOOLS) $(EXTERNAL)
	$(AR) $(ARFLAGS) ${DIR_BUILDLIB}/$@ $(addprefix ${DIR_BUILDOBJ}/, $(notdir $^))

${LIBNAME}: $(SOURCE) $(TOOLS) $(EXTERNAL) $(OUTPUT) $(CLASS)
	$(CC) $(CFLAGS) $(addprefix ${DIR_BUILDOBJ}/, $(notdir $^)) -o ${DIR_BUILD}/$@ $(LDFLAGS) $(LDLIBS)

${PKGNAME}: lib${LIBNAME}.a ${DIR_PYTHON}/c${PKGNAME}.pxd ${DIR_PYTHON}/${PKGNAME}.pyx
	cd ${DIR_PYTHON} && \
	CC=$(CC) INCLUDES="$(INCLUDES)" CFLAGS_OMP="${CFLAGS_OMP}" LDFLAGS_OMP="${LDFLAGS_OMP}" $(PYTHON) -m pip install -vvv -e .


# ------------------------------------------------------------------------
# Testing
# ------------------------------------------------------------------------

test_background: $(SOURCE) $(TOOLS) $(EXTERNAL) $(TEST_BACKGROUND)
	$(CC) $(CFLAGS) -o $@ $(addprefix ${DIR_BUILDOBJ}/, $(notdir $^)) $(LDFLAGS) $(LDLIBS)

test_nonlinear: $(SOURCE) $(TOOLS) $(EXTERNAL) $(TEST_NONLINEAR)
	$(CC) $(CFLAGS) -o $@ $(addprefix ${DIR_BUILDOBJ}/, $(notdir $^)) $(LDFLAGS) $(LDLIBS)

test_perturbations: $(SOURCE) $(TOOLS) $(EXTERNAL) $(TEST_PERTURBATIONS)
	$(CC) $(CFLAGS) -o $@ $(addprefix ${DIR_BUILDOBJ}/, $(notdir $^)) $(LDFLAGS) $(LDLIBS)

test_thermodynamics: $(TOOLS) $(SOURCE) $(EXTERNAL) $(TEST_THERMODYNAMICS)
	$(CC) $(CFLAGS) -o $@ $(addprefix ${DIR_BUILDOBJ}/, $(notdir $^)) $(LDFLAGS) $(LDLIBS)

test_transfer: $(TOOLS) $(SOURCE) $(EXTERNAL) $(TEST_TRANSFER)
	$(CC) $(CFLAGS) -o $@ $(addprefix ${DIR_BUILDOBJ}/, $(notdir $^)) $(LDFLAGS) $(LDLIBS)

test_degeneracy: $(SOURCE) $(TOOLS) $(EXTERNAL) $(OUTPUT) $(TEST_DEGENERACY)
	$(CC) $(CFLAGS) -o $@ $(addprefix ${DIR_BUILDOBJ}/, $(notdir $^)) $(LDFLAGS) $(LDLIBS)

test_loops: $(SOURCE) $(TOOLS) $(EXTERNAL) $(OUTPUT) $(TEST_LOOPS)
	$(CC) $(CFLAGS) -o $@ $(addprefix ${DIR_BUILDOBJ}/, $(notdir $^)) $(LDFLAGS) $(LDLIBS)

test_loops_omp: $(SOURCE) $(TOOLS) $(EXTERNAL) $(OUTPUT) $(TEST_LOOPS_OMP)
	$(CC) $(CFLAGS) -o $@ $(addprefix ${DIR_BUILDOBJ}/, $(notdir $^)) $(LDFLAGS) $(LDLIBS)

test_sigma: $(SOURCE) $(TOOLS) $(EXTERNAL) $(OUTPUT) $(TEST_SIGMA)
	$(CC) $(CFLAGS) -o $@ $(addprefix ${DIR_BUILDOBJ}/, $(notdir $^)) $(LDFLAGS) $(LDLIBS)

test_stephane: $(SOURCE) $(TOOLS) $(EXTERNAL) $(OUTPUT) $(TEST_STEPHANE)
	$(CC) $(CFLAGS) -o $@ $(addprefix ${DIR_BUILDOBJ}/, $(notdir $^)) $(LDFLAGS) $(LDLIBS)

test_hyperspherical: $(TOOLS) $(TEST_HYPERSPHERICAL)
	$(CC) $(CFLAGS) -o $@ $(addprefix ${DIR_BUILDOBJ}/, $(notdir $^)) $(LDFLAGS) $(LDLIBS)


# ------------------------------------------------------------------------
# Removals
# ------------------------------------------------------------------------

uninstall: clean
	$(PYTHON) -m pip uninstall -y ${PKGNAME}

clean: .base
	rm -rf ${DIR_BUILD}
	rm -rf ${DIR_PYTHON}/${PKGNAME}.c ${DIR_PYTHON}/${PKGNAME}.*.so ${DIR_PYTHON}/${PKGNAME}.egg-info
